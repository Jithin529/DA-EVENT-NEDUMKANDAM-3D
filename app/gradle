plugins {
    id 'com.android.application'
}

android {
    namespace 'com.example.daevent' // match your app namespace
    compileSdk 35 // set to the Android SDK platform installed in CI

    defaultConfig {
        applicationId "com.example.daevent"
        minSdk 24
        targetSdk 35
        versionCode 1
        versionName "1.0"
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}

dependencies {
    // your app dependencies
}
